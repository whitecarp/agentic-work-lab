<!-- Gemini-chan overlay layout: speech bubble on the left, her picture on the right.
     Float carries her idle bob and sway, Body her squash; ArtA and ArtB are the two
     layers a pose change crossfades between. The stars stay put while she floats. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
  ShowActivated="False" Focusable="False" SizeToContent="WidthAndHeight" Opacity="0" Left="-10000" Top="-10000"
  FontFamily="Microsoft YaHei UI, Segoe UI">
  <Grid x:Name="Root" Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="208"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,0,34">
      <Border CornerRadius="16" BorderThickness="1.5" BorderBrush="#C0A77BFF">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4161D52" Offset="0"/><GradientStop Color="#F40B1030" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#6E8BFF" Opacity="0.7"/></Border.Effect>
        <StackPanel Margin="14,12,14,12">
          <TextBlock x:Name="Name" Foreground="#FF8FD0" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
          <TextBlock x:Name="Say" Foreground="#EEF0FF" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,9"/>
          <Border x:Name="PartnerBox" CornerRadius="8" Padding="9,6" Background="#1FFFFFFF">
            <TextBlock x:Name="Partner" FontSize="12.5" TextWrapping="Wrap"/>
          </Border>
          <TextBlock x:Name="Credit" Foreground="#99AEB5DE" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Path Data="M0,0 L16,9 L0,18 Z" Fill="#F40B1030" Stroke="#C0A77BFF" StrokeThickness="1.5"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,22"/>
    </Grid>
    <Grid Grid.Column="2" Width="208" Height="260" VerticalAlignment="Bottom">
      <Grid x:Name="Float">
        <Grid x:Name="Body">
          <Image x:Name="ArtB" Width="208" Height="260" Stretch="Uniform" VerticalAlignment="Bottom" Opacity="0" RenderOptions.BitmapScalingMode="HighQuality"/>
          <Image x:Name="ArtA" Width="208" Height="260" Stretch="Uniform" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
      </Grid>
      <Canvas x:Name="Stars" IsHitTestVisible="False"/>
    </Grid>
  </Grid>
</Window>
